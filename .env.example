POSTGRES_USER=sonrisas_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sonrisas_cristal
POSTGRES_PORT=5432
API_PORT=8000
# Separate login used by the API; keep it different from POSTGRES_USER.
API_DB_USER=sonrisas_api
# Use a long URL-safe password because it is included in DATABASE_URL.
API_DB_PASSWORD=replace_with_a_long_url_safe_password
PASSWORD_PEPPER_FILE=./secrets/password_pepper
SECRET_KEY=change_me_to_a_random_string_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CLOUDFLARED_ORIGIN_SERVER_NAME=api.example.com
